# Recap — configuration template
#
#     cp .env.example .env
#
# THIS FILE IS OPTIONAL.
#
# The normal way to set up Recap is the Settings drawer in the app: paste the
# tokens, tick "Remember on this machine", done. Nothing here is required for
# that.
#
# Use `.env` when you would rather keep configuration as code — scripted setup,
# dotfiles, provisioning a new laptop — or to set PORT, GITLAB_ENRICH and
# RECAP_CREDENTIALS_PATH, which the UI does not cover.
#
# `.env` is gitignored and must stay that way: it can hold real tokens.
# Recap never writes to this file; it is yours to edit.
#
# Every value is optional. Recap runs with whatever is configured and reports
# the rest as "not connected" — you do not need all four sources.
#
# Precedence: Settings drawer (session) > saved credential file > this file.


# ─────────────────────────────────────────────────────────── server
# Port to listen on. Overridden by --port on the command line.
PORT=4319


# ─────────────────────────────────────────────────────────── local git
# Absolute paths to the clones you want summarised, comma separated.
# Read-only: Recap only ever runs `git log`.
RECAP_GIT_REPOS=/home/you/Projects/api,/home/you/Projects/web

# Which commits are yours. Matched against the commit author.
# Leave blank to use `git config user.email` from the first repo.
# Without this, a shared repository returns the whole team's commits.
RECAP_GIT_AUTHOR=you@example.com


# ─────────────────────────────────────────────────────────── gitlab
# Instance root — no /api/v4 suffix. Works with gitlab.com and self-hosted.
GITLAB_BASE_URL=https://gitlab.example.com

# Personal access token, scope: read_api
# Profile → Preferences → Access Tokens
GITLAB_TOKEN=

# Set to 1 to also fetch per-MR diff stats and approval counts.
# Costs one extra request per merge request; off by default.
GITLAB_ENRICH=0


# ─────────────────────────────────────────────────────────── jira
# Your Atlassian Cloud site root, no trailing path.
JIRA_BASE_URL=https://your-site.atlassian.net

# The email of the Atlassian ACCOUNT that owns the token below.
# An alias or a group address will be rejected with 401.
JIRA_EMAIL=you@example.com

# API token from https://id.atlassian.com/manage-profile/security/api-tokens
#
# Use "Create API token" — NOT "Create API token with scopes".
# A classic token starts with ATATT and works with Basic auth.
# A scoped token starts with ATCTT and will always 401 here.
JIRA_API_TOKEN=


# ─────────────────────────────────────────────────────────── confluence
# Same site as Jira, plus the /wiki prefix. The prefix is required.
CONFLUENCE_BASE_URL=https://your-site.atlassian.net/wiki

# Both default to the Jira values above when left blank, which is correct
# whenever Jira and Confluence are on the same Atlassian site.
CONFLUENCE_EMAIL=
CONFLUENCE_API_TOKEN=


# ─────────────────────────────────────────────────────── credential storage
# Where Recap keeps credentials you save from the Settings drawer.
# Leave blank to use the platform default:
#   Linux/macOS  ~/.config/recap/credentials.json
#   Windows      %APPDATA%\recap\credentials.json
#
# Setting this pins the location and makes the field read-only in the UI.
# It must be outside this project directory — Recap refuses to write
# credentials anywhere that could be committed.
RECAP_CREDENTIALS_PATH=
